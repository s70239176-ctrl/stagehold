# Every value is optional; the defaults below are what the app uses when a variable is not set.
# Never put a private key or wallet seed in this file. The app makes throwaway accounts in the browser.

# GenLayer Studionet RPC (chain ID 61999)
NEXT_PUBLIC_GENLAYER_RPC=https://studio.genlayer.com/api

# Block explorer used for contract links
NEXT_PUBLIC_EXPLORER_URL=https://explorer-studio.genlayer.com
